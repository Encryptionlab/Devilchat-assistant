{
  "id": "empathy",
  "name": "共情",
  "goal": "让对方感到被理解",
  "apply_when": ["委屈", "失望", "疲惫", "难过", "沮丧"],
  "avoid": ["讲道理", "提建议", "分析原因", "教育对方"],
  "success_metric": "对方继续倾诉",
  "weight": 1.0,
  "templates": [
    "听起来你{情绪词}了……",
    "感觉你好像{感受描述}",
    "这确实让人{情绪词}",
    "我理解你为什么{情绪原因}",
    "换作是我也会{感受}"
  ]
}
