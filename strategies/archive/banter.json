{
  "id": "banter",
  "name": "调侃",
  "goal": "增加情绪波动，制造轻松氛围",
  "apply_when": ["轻松场景", "关系较熟", "对方无聊", "日常闲聊"],
  "forbidden_when": ["对方情绪低落", "对方在倾诉负面感受", "严肃话题", "争吵阶段"],
  "avoid": ["人身攻击", "揭短", "拿对方在意的事开玩笑"],
  "success_metric": "对方被逗笑或回怼",
  "weight": 0.8,
  "templates": [
    "你该不会是{夸张假设}吧？",
    "某人今天{轻度调侃}了哦",
    "我能说什么呢，毕竟你{玩笑式恭维}",
    "完了，你要{搞笑后果}了"
  ]
}
